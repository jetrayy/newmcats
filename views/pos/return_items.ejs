<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MCATS | Item Return Desk</title>
    <link rel="icon" type="image/x-icon" href="/img/ico.ico">
    <!-- Instant theme apply — prevents flash -->
    <script>document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'light');</script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Luxury Core CSS -->
    <link rel="stylesheet" href="/css/luxury.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--luxury-body-bg); min-height: 100vh; display: flex; flex-direction: column; }
        .top-navbar {
            background: var(--obsidian-sidebar);
            border-bottom: 1px solid var(--obsidian-border);
            padding: 1rem 1.5rem;
        }
        .rental-card {
            background: var(--luxury-card-bg);
            border: 1px solid var(--luxury-card-border);
            border-radius: var(--radius-xl);
            transition: all 0.26s ease;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }
        .rental-card:hover {
            transform: translateY(-4px);
            border-color: rgba(212, 175, 55, 0.45);
            box-shadow: var(--shadow-glow);
            color: inherit;
        }
        .rental-card-footer {
            background: rgba(212, 175, 55, 0.08);
            border-top: 1px solid rgba(212, 175, 55, 0.18);
            color: var(--gold-primary);
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.04em;
            transition: all 0.2s ease;
        }
        .rental-card:hover .rental-card-footer {
            background: var(--gold-primary);
            color: #070a12;
        }
    </style>
</head>
<body>

    <div class="top-navbar d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 42px; height: 42px; background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.3);">
                <i class="fa-solid fa-boxes-packing" style="color: var(--gold-primary);"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-white" style="font-family: 'Outfit', sans-serif; letter-spacing: 0.04em;">Item Return Desk</h5>
                <small class="text-secondary">Active gear leases & return settlement processing</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/views/pos/pay_later.php" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold shadow-sm border-warning">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> Pay Later Desk
                <% if (typeof allPayLaterTotal !== 'undefined' && allPayLaterTotal > 0) { %>
                    <span class="badge bg-warning text-dark ms-1"><%= allPayLaterTotal %></span>
                <% } %>
            </a>
            <a href="/views/pos/rent.php" class="btn btn-sm btn-luxury-gold rounded-pill px-3 fw-bold shadow-sm">
                <i class="fa-solid fa-cart-flatbed me-1"></i> Rentals Terminal
            </a>
            <a href="/views/admin/home.php" class="btn btn-sm btn-outline-secondary text-white rounded-pill px-3 fw-semibold shadow-sm border-secondary">
                <i class="fa-solid fa-gauge me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <div class="container-fluid py-4 flex-grow-1" style="max-width: 1400px; margin: 0 auto;">
        
        <!-- Flash Notice if payment recorded -->
        <% if (typeof paymentSuccess !== 'undefined' && paymentSuccess) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark">Payment Recorded Successfully!</strong>
                        <span class="text-secondary small">Pay Later customer account updated.</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Unsettled Pay Later Alert Banner if pending credit exists -->
        <% if (typeof allPayLaterTotal !== 'undefined' && allPayLaterTotal > 0 && !searchFilter) { %>
            <div class="alert alert-warning border-warning border-opacity-50 rounded-4 shadow-sm p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: rgba(245, 158, 11, 0.08);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: rgba(245, 158, 11, 0.2); color: #d97706;">
                        <i class="fa-solid fa-hand-holding-dollar fs-5"></i>
                    </div>
                    <div>
                        <strong class="text-dark d-block">Notice: <%= allPayLaterTotal %> Outstanding Pay Later Bill<%= allPayLaterTotal > 1 ? 's' : '' %> Active</strong>
                        <span class="text-secondary small">Some regular clients have deferred unpaid balances on returned gear. Search by customer name/NIC below or open the Pay Later directory.</span>
                    </div>
                </div>
                <a href="/views/pos/pay_later.php" class="btn btn-warning btn-sm rounded-pill fw-bold px-3 text-dark">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Open Pay Later Directory
                </a>
            </div>
        <% } %>

        <!-- Filters -->
        <div class="card p-3 p-md-4 mb-4 rounded-4" style="background: var(--luxury-card-bg); border: 1px solid var(--luxury-card-border); box-shadow: var(--shadow-sm);">
            <form method="GET" action="/views/pos/return_items.php" class="row align-items-end g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary small mb-1 text-uppercase" style="letter-spacing: 0.05em;">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Client Search
                    </label>
                    <input type="text" name="search" class="form-control border-secondary-subtle" placeholder="Query by client name, NIC, or phone number..." value="<%= (typeof searchFilter !== 'undefined' && searchFilter) ? searchFilter : '' %>">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary small mb-1 text-uppercase" style="letter-spacing: 0.05em;">
                        <i class="fa-regular fa-calendar me-1"></i> Agreement Date
                    </label>
                    <input type="date" name="date" class="form-control border-secondary-subtle" value="<%= (typeof dateFilter !== 'undefined' && dateFilter !== 'all') ? dateFilter : '' %>">
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-luxury-gold flex-grow-1 fw-bold rounded-pill">
                        <i class="fa-solid fa-filter me-1"></i> Filter Leases
                    </button>
                    <a href="/views/pos/return_items.php" class="btn btn-outline-secondary border-secondary-subtle rounded-pill px-3" title="Reset">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- SEARCH RESULTS: Pay Later Bills Section (Triggered when searching customer details) -->
        <% if (typeof payLaterBills !== 'undefined' && payLaterBills && payLaterBills.length > 0) { %>
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0 text-warning d-flex align-items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left"></i> Pay Later Accounts For This Customer (<%= payLaterBills.length %>)
                    </h5>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1">Deferred Balance Pending</span>
                </div>

                <div class="row g-4">
                    <% payLaterBills.forEach(function(pb) { 
                        const tid = pb.bill_number;
                        const cname = pb.c_name || "Walk-in Client";
                        const cphone = pb.c_phone || "No Phone";
                        const cnic = pb.customer_nic || pb.c_nic || "Unspecified";
                        const pendingDue = Number(pb.pending_due || 0);
                        const isSettled = Boolean(pb.is_settled);
                        const d = new Date(pb.transaction_date);
                        const dateFmt = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    %>
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="rental-card h-100 <%= isSettled ? 'settled' : '' %>">
                            <div class="p-3 border-bottom border-secondary-subtle d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-bold fs-6 mb-1 text-truncate" title="<%= cname %>"><%= cname %></div>
                                    <div class="text-secondary small">
                                        <i class="fa-regular fa-id-card me-1"></i><%= cnic %>
                                    </div>
                                    <div class="text-secondary small">
                                        <i class="fa-solid fa-phone me-1"></i><%= cphone %>
                                    </div>
                                </div>
                                <span class="badge" style="background: rgba(212, 175, 55, 0.15); color: var(--gold-primary); font-family: 'Outfit', sans-serif; font-size: 0.85rem; padding: 0.35rem 0.6rem;">
                                    #<%= tid %>
                                </span>
                            </div>
                            
                            <div class="p-3 flex-grow-1">
                                <div class="d-flex justify-content-between mb-2 small">
                                    <span class="text-secondary">Agreement Timestamp:</span>
                                    <span class="fw-semibold small"><%= dateFmt %></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 small">
                                    <span class="text-secondary">Total Lease Charge:</span>
                                    <span class="fw-bold">Rs. <%= Number(pb.total_charge || pb.total_lkr || 0).toFixed(2) %></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 small">
                                    <span class="text-secondary">Paid to Date:</span>
                                    <span class="fw-bold text-success">Rs. <%= Number(pb.total_paid || pb.received_amount || 0).toFixed(2) %></span>
                                </div>
                                <div class="d-flex justify-content-between mb-3 small p-2 rounded-2 <%= isSettled ? 'bg-success bg-opacity-10 border border-success border-opacity-25' : 'bg-danger bg-opacity-10 border border-danger border-opacity-25' %>">
                                    <span class="fw-bold <%= isSettled ? 'text-success' : 'text-danger' %>"><%= isSettled ? 'Status:' : 'Pay Later Due:' %></span>
                                    <span class="fw-bold <%= isSettled ? 'text-success' : 'text-danger' %> fs-6">
                                        <%= isSettled ? 'Fully Settled' : ('Rs. ' + pendingDue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) %>
                                    </span>
                                </div>
                                
                                <div class="p-2 rounded-3 small" style="background: rgba(0, 0, 0, 0.03); border: 1px solid var(--luxury-card-border);">
                                    <strong class="d-block mb-1 text-secondary" style="font-size: 0.76rem; text-uppercase; letter-spacing: 0.05em;">
                                        <i class="fa-solid fa-camera-retro me-1" style="color: var(--gold-primary);"></i> Dispatched Equipment:
                                    </strong>
                                    <ul class="mb-0 ps-3 text-secondary" style="font-size: 0.8rem;">
                                        <% if (pb.items && pb.items.length > 0) { %>
                                            <% pb.items.slice(0, 3).forEach(function(it) { %>
                                                <li><%= it.quantity %>× <%= it.item_name %></li>
                                            <% }); %>
                                            <% if (pb.items.length > 3) { %>
                                                <li class='fst-italic'>+ <%= pb.items.length - 3 %> additional items...</li>
                                            <% } %>
                                        <% } else { %>
                                            <li class='fst-italic'>Rental package items</li>
                                        <% } %>
                                    </ul>
                                </div>

                                <% if (pb.notes) { %>
                                    <div class="mt-2 p-1 px-2 rounded bg-warning bg-opacity-10 border border-warning border-opacity-25 text-dark" style="font-size: 0.78rem;">
                                        <i class="fa-solid fa-note-sticky me-1 text-warning"></i> <%= pb.notes %>
                                    </div>
                                <% } %>
                            </div>
                            
                            <div class="p-2 px-3 border-top border-secondary-subtle d-flex gap-2 align-items-center">
                                <% if (!isSettled) { %>
                                    <a href="/views/pos/print_bill.php?type=a4&bill_id=<%= tid %>&collect=1" target="_blank" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark flex-grow-1 shadow-sm d-flex align-items-center justify-content-center gap-1">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i> Collect Payment
                                    </a>
                                <% } else { %>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-2 px-3 flex-grow-1 text-center">
                                        <i class="fa-solid fa-circle-check me-1"></i> Fully Cleared
                                    </span>
                                <% } %>
                                <a href="/views/pos/print_bill.php?type=a4&bill_id=<%= tid %>" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="View / Print Bill">
                                    <i class="fa-solid fa-print"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <hr class="my-4 border-secondary-subtle">
            </div>
        <% } %>

        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-boxes-packing" style="color: var(--gold-primary);"></i> Active Rental Leases Awaiting Return (<%= rentals.length %>)
            </h5>
        </div>

        <!-- Rentals Grid -->
        <div class="row g-4">
            <% if (rentals && rentals.length > 0) { %>
                <% rentals.forEach(function(rental) { 
                    const tid = rental.bill_number;
                    const cname = rental.c_name || "Walk-in Client";
                    const cphone = rental.c_phone || "No Phone";
                    const cnic = rental.customer_nic || "Unspecified";
                    const d = new Date(rental.transaction_date);
                    const dateFmt = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' • ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
                %>
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <a href="/views/pos/return_checkout.php?bill_id=<%= tid %>" class="rental-card h-100">
                        <div class="p-3 border-bottom border-secondary-subtle d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold fs-6 mb-1 text-truncate" title="<%= cname %>"><%= cname %></div>
                                <div class="text-secondary small">
                                    <i class="fa-regular fa-id-card me-1"></i><%= cnic %>
                                </div>
                                <div class="text-secondary small">
                                    <i class="fa-solid fa-phone me-1"></i><%= cphone %>
                                </div>
                            </div>
                            <span class="badge" style="background: rgba(212, 175, 55, 0.15); color: var(--gold-primary); font-family: 'Outfit', sans-serif; font-size: 0.85rem; padding: 0.35rem 0.6rem;">
                                #<%= tid %>
                            </span>
                        </div>
                        
                        <div class="p-3 flex-grow-1">
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-secondary">Agreement Timestamp:</span>
                                <span class="fw-semibold small"><%= dateFmt %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 small">
                                <span class="text-secondary">Security Advance:</span>
                                <span class="fw-bold text-success">Rs. <%= Number(rental.advance_paid || 0).toFixed(2) %></span>
                            </div>
                            
                            <div class="p-2 rounded-3 small" style="background: rgba(0, 0, 0, 0.03); border: 1px solid var(--luxury-card-border);">
                                <strong class="d-block mb-1 text-secondary" style="font-size: 0.76rem; text-uppercase; letter-spacing: 0.05em;">
                                    <i class="fa-solid fa-camera-retro me-1" style="color: var(--gold-primary);"></i> Dispatched Equipment:
                                </strong>
                                <ul class="mb-0 ps-3 text-secondary" style="font-size: 0.8rem;">
                                    <% if (rental.items && rental.items.length > 0) { %>
                                        <% rental.items.slice(0, 3).forEach(function(it) { %>
                                            <li><%= it.quantity %>× <%= it.item_name %></li>
                                        <% }); %>
                                        <% if (rental.items.length > 3) { %>
                                            <li class='fst-italic'>+ <%= rental.items.length - 3 %> additional items...</li>
                                        <% } %>
                                    <% } else { %>
                                        <li class='fst-italic'>Standard package</li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                        
                        <div class="rental-card-footer text-center p-3">
                            Process Return & Settlement <i class="fa-solid fa-arrow-right ms-1"></i>
                        </div>
                    </a>
                </div>
                <% }); %>
            <% } else { %>
                <div class="col-12">
                    <div class="text-center py-5 rounded-4 border border-secondary-subtle" style="background: var(--luxury-card-bg);">
                        <i class="fa-solid fa-clipboard-check fs-1 d-block mb-3" style="color: var(--gold-primary); opacity: 0.4;"></i>
                        <h4 class="fw-bold">No Active Leases Found</h4>
                        <p class="text-secondary small mb-0">All equipment is returned, or no active ongoing records matched your filter criteria.</p>
                        <% if (typeof payLaterBills !== 'undefined' && payLaterBills && payLaterBills.length > 0) { %>
                            <p class="text-warning small mt-2 fw-semibold">Note: Matching Pay Later credit bill(s) for this customer are displayed above.</p>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
