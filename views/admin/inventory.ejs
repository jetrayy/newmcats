                <div class="luxury-card overflow-hidden mb-5">
                    <div class="table-responsive">
                        <table class="luxury-table align-middle" id="invTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Rate (LKR)</th>
                                    <th class="text-center">Cost Code 🔒</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (items && items.length > 0) { %>
                                    <% items.forEach(function(row) { %>
                                    <% 
                                    const rowImg = row.item_image ? (row.item_image.startsWith('data:') || row.item_image.startsWith('/') ? row.item_image : ('/img/' + row.item_image)) : '/img/default.png';
                                    %>
                                    <tr>
                                        <td class="text-muted fw-bold" style="font-family: var(--font-heading);">
                                            #<%= String(row.item_id).padStart(4, '0') %>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="<%= rowImg %>" onerror="this.src='/img/default.png'" class="rounded-2 flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover; border: 1px solid var(--border-subtle);" alt="Thumbnail">
                                                <div class="fw-bold text-main"><%= row.item_name %></div>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (row.category === 'Rental Items') { %>
                                                <span class="luxury-badge luxury-badge-gold">Rental Items</span>
                                            <% } else if (row.category === 'Power Tools') { %>
                                                <span class="luxury-badge luxury-badge-emerald">Power Tools</span>
                                            <% } else { %>
                                                <span class="luxury-badge luxury-badge-slate">Hardware Goods</span>
                                            <% } %>
                                        </td>
                                        <td class="fw-bold" style="font-family: var(--font-heading); color: var(--gold-primary);">
                                            Rs. <%= Number(row.price_per_unit).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge px-3 py-1 fw-bold" style="font-family: 'Courier New', monospace; letter-spacing: 2px; background: var(--bg-surface-elevated); color: var(--text-secondary); border: 1px solid var(--border-subtle);">
                                                <%= row.bought_price ? encodePrice(row.bought_price) : '—' %>
                                            </span>
                                        </td>
                                        <td class="fw-bold">
                                            <% if (row.stock_quantity <= 3) { %>
                                                <span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i><%= row.stock_quantity %></span>
                                            <% } else { %>
                                                <span><%= row.stock_quantity %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (row.status === 'available') { %>
                                                <span class="luxury-badge luxury-badge-emerald"><i class="fa-solid fa-check"></i> Available</span>
                                            <% } else { %>
                                                <span class="luxury-badge luxury-badge-crimson"><i class="fa-solid fa-clock"></i> Rented</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a href="/views/admin/inventory.php?edit=<%= row.item_id %>#itemForm" class="btn btn-sm btn-luxury-outline py-1 px-2">
                                                <i class="fa-solid fa-pen-to-square"></i> Edit
                                            </a>
                                            <a href="/views/admin/inventory.php?delete=<%= row.item_id %>" class="btn btn-sm btn-outline-danger py-1 px-2 ms-1 rounded-2" onclick="return confirm('Are you sure you want to delete this item?');" style="border-width: 1px;">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan='8' class='text-center text-muted py-5'><i class='fa-solid fa-box-open d-block fs-1 mb-2 opacity-50'></i>No inventory items registered in catalog. Add one above!</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Inline Change Request Modal -->
    <div class="modal fade" id="inlineRequestModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); color: var(--text-primary);">
                <form action="/api/requests/create" method="POST">
                    <input type="hidden" name="redirect_to" value="/views/admin/inventory.php">
                    <input type="hidden" name="item_id" id="modalItemId">
                    <input type="hidden" name="type" id="modalReqType">

                    <div class="modal-header border-bottom" style="border-color: var(--border-subtle) !important;">
                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                            <i id="modalHeaderIcon" class="fa-solid fa-paper-plane text-warning"></i>
                            <span id="modalTitle">Submit Change Request</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Target Item</label>
                            <input type="text" id="modalItemNameDisplay" class="form-control luxury-input" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Current Value</label>
                            <input type="text" id="modalCurrentValDisplay" class="form-control luxury-input" readonly style="opacity: 0.7;">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold" id="modalRequestedValueLabel">Proposed New Value</label>
                            <input type="text" name="requested_value" id="modalRequestedValInput" class="form-control luxury-input" required placeholder="e.g. 15">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Reason / Notes for Super Admin</label>
                            <textarea name="reason" rows="2" class="form-control luxury-input" placeholder="Explain why this edit is required..." required></textarea>
                        </div>
                        <div class="alert alert-info small py-2 mb-0 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>Once Super Admin accepts this request, you will receive a direct link to edit and apply this detail.</span>
                        </div>
                    </div>
                    <div class="modal-footer border-top" style="border-color: var(--border-subtle) !important;">
                        <button type="button" class="btn btn-luxury-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-luxury-gold"><i class="fa-solid fa-paper-plane me-1"></i> Send Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById('themeToggle');
        const html = document.documentElement;

        function updateToggleText() {
            if (html.getAttribute('data-bs-theme') === 'dark') {
                toggleBtn.innerHTML = '☀️ Light Mode';
            } else {
                toggleBtn.innerHTML = '🌙 Dark Mode';
            }
        }

        if (localStorage.getItem('theme') === 'dark') {
            html.setAttribute('data-bs-theme', 'dark');
            updateToggleText();
        }

        toggleBtn.addEventListener('click', () => {
            if (html.getAttribute('data-bs-theme') === 'dark') {
                html.setAttribute('data-bs-theme', 'light');
                localStorage.setItem('theme', 'light');
            } else {
                html.setAttribute('data-bs-theme', 'dark');
                localStorage.setItem('theme', 'dark');
            }
            updateToggleText();
        });

        function updateClock() {
            const now = new Date();
            const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
            const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
            document.getElementById('realtimeClock').innerHTML = '<i class="fa-regular fa-clock me-1"></i> ' + dateStr + ' &bull; ' + timeStr;
        }
        setInterval(updateClock, 1000);
        updateClock();

        function filterInventory() {
            const val = document.getElementById('inventorySearch').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#invTable tbody tr');
            let visibleCount = 0;
            rows.forEach(r => {
                const match = !val || r.innerText.toLowerCase().includes(val);
                r.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });
            const badge = document.getElementById('invCountBadge');
            if (badge) {
                badge.innerText = val ? `Showing \${visibleCount} matching items` : `\${rows.length} items total`;
            }
        }

        function clearSearch() {
            const input = document.getElementById('inventorySearch');
            if (input) {
                input.value = '';
                filterInventory();
                input.focus();
            }
        }

        // Image Upload Handlers
        function handleImageSelection(fileInput) {
            const file = fileInput.files && fileInput.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                alert('Please select a valid image file (PNG, JPG, WEBP, etc.)');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('imagePreview');
                const dataInput = document.getElementById('itemImageDataInput');
                const nameDisplay = document.getElementById('imageFileNameDisplay');
                const nameInput = document.getElementById('itemImageNameInput');

                if (preview) preview.src = e.target.result;
                if (dataInput) dataInput.value = e.target.result;
                if (nameDisplay) nameDisplay.innerHTML = `<span class="text-success"><i class="fa-solid fa-check me-1"></i>New Image: <b>\${file.name}</b> (\${Math.round(file.size / 1024)} KB)</span>`;
                if (nameInput) nameInput.value = file.name;
            };
            reader.readAsDataURL(file);
        }

        function resetItemImage() {
            const fileInput = document.getElementById('itemImageFileInput');
            const dataInput = document.getElementById('itemImageDataInput');
            const existingInput = document.getElementById('existingImageInput');
            const nameInput = document.getElementById('itemImageNameInput');
            const nameDisplay = document.getElementById('imageFileNameDisplay');
            const preview = document.getElementById('imagePreview');

            if (fileInput) fileInput.value = '';
            if (dataInput) dataInput.value = '';

            const orig = existingInput ? existingInput.value : 'default.png';
            if (nameInput) nameInput.value = orig;
            if (preview) {
                preview.src = orig.startsWith('data:') || orig.startsWith('/') ? orig : ('/img/' + orig);
            }
            if (nameDisplay) {
                nameDisplay.innerHTML = `Current: \${orig}`;
            }
        }

        // Drag and Drop on dropzone
        const dropzone = document.getElementById('imageDropzone');
        if (dropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.borderColor = 'var(--gold-primary)';
                    dropzone.style.background = 'rgba(212,175,55,0.08)';
                }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.borderColor = 'var(--border-subtle)';
                    dropzone.style.background = 'var(--bg-surface-elevated)';
                }, false);
            });
            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    const input = document.getElementById('itemImageFileInput');
                    input.files = files;
                    handleImageSelection(input);
                }
            });
        }

        // Inline Request Modal Handler
        function openInlineRequestModal(type, itemId, itemName, currentVal) {
            const modalEl = document.getElementById('inlineRequestModal');
            if (!modalEl) return;

            document.getElementById('modalItemId').value = itemId;
            document.getElementById('modalReqType').value = type;
            document.getElementById('modalItemNameDisplay').value = `#\${String(itemId).padStart(4, '0')} - \${itemName}`;
            document.getElementById('modalCurrentValDisplay').value = currentVal || '—';

            const title = document.getElementById('modalTitle');
            const valLabel = document.getElementById('modalRequestedValueLabel');
            const valInput = document.getElementById('modalRequestedValInput');
            const headerIcon = document.getElementById('modalHeaderIcon');

            if (type === 'quantity') {
                title.innerText = 'Request Item Quantity Edit';
                valLabel.innerText = 'Proposed New Stock Quantity';
                valInput.type = 'number';
                valInput.min = '0';
                valInput.step = '1';
                valInput.placeholder = 'e.g. 10';
                headerIcon.className = 'fa-solid fa-cubes-stacked text-warning';
            } else if (type === 'daily_rate') {
                title.innerText = 'Request Daily Rate Edit';
                valLabel.innerText = 'Proposed Daily Rate (LKR)';
                valInput.type = 'number';
                valInput.min = '0';
                valInput.step = '0.01';
                valInput.placeholder = 'e.g. 1500.00';
                headerIcon.className = 'fa-solid fa-tags text-info';
            } else if (type === 'cost_price') {
                title.innerText = 'Request Cost Price Edit';
                valLabel.innerText = 'Proposed Cost Price or Cipher Code';
                valInput.type = 'text';
                valInput.placeholder = 'e.g. 1200 or BLACK';
                headerIcon.className = 'fa-solid fa-key text-secondary';
            }

            valInput.value = '';

            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();
        }

        // Automatic smooth scroll and focus into itemForm when edit mode is active
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('edit') || urlParams.has('grant_id') || window.location.hash === '#itemForm') {
                const targetForm = document.getElementById('itemForm');
                if (targetForm) {
                    setTimeout(() => {
                        targetForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        // Add gentle pulse highlight
                        targetForm.style.transition = 'box-shadow 0.4s ease, border-color 0.4s ease';
                        targetForm.style.borderColor = 'var(--gold-primary)';
                        targetForm.style.boxShadow = '0 0 25px rgba(212, 175, 55, 0.35)';
                        
                        // Focus first editable input
                        const firstInput = targetForm.querySelector('input:not([type="hidden"]):not([readonly]):not([disabled])');
                        if (firstInput) {
                            firstInput.focus();
                        }
                    }, 100);
                }
            }
        });
    </script>
</body>
</html>
