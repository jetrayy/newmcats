<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MCATS | Inventory Change Requests</title>
    <link rel="icon" type="image/x-icon" href="/img/ico.ico">
    <!-- Instant theme apply — prevents flash -->
    <script>document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'light');</script>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Luxury Executive Design System -->
    <link rel="stylesheet" href="/css/luxury.css">
</head>
<body>

    <!-- Mobile Navbar -->
    <nav class="navbar navbar-dark d-md-none px-3" style="background: var(--obsidian-sidebar); border-bottom: 1px solid var(--obsidian-border);">
        <span class="navbar-brand mb-0 h1 luxury-brand-title">MCATS ADMIN</span>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block luxury-sidebar offcanvas-md offcanvas-start">
                <div class="position-sticky pt-3 px-3">
                    <div class="d-none d-md-block mb-4 text-center pb-3 border-bottom" style="border-color: var(--obsidian-border) !important;">
                        <img src="/img/logo.png" style="width: 70px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));" class="mb-2" alt="MCATS Logo">
                        <h4 class="luxury-brand-title m-0">MCATS <%= user.role === 'super_admin' ? 'SA' : 'ADMIN' %></h4>
                        <small class="text-white-50" style="font-size: 0.725rem; letter-spacing: 0.1em;">CONTROL SUITE</small>
                    </div>
                    <div class="nav flex-column">
                        <% if (user.role === 'super_admin') { %>
                            <a href="/views/admin/sahome.php" class="luxury-nav-link"><i class="fa-solid fa-gauge"></i>Dashboard</a>
                            <a href="/views/admin/inventory.php" class="luxury-nav-link"><i class="fa-solid fa-boxes-stacked"></i>Inventory</a>
                            <a href="/views/admin/requests_qty.php" class="luxury-nav-link <%= pageType === 'quantity' ? 'active' : '' %>"><i class="fa-solid fa-cubes-stacked"></i>Qty Requests <% if (counts && counts.pendingQty > 0) { %><span class="badge bg-warning text-dark ms-auto"><%= counts.pendingQty %></span><% } %></a>
                            <a href="/views/admin/requests_rate.php" class="luxury-nav-link <%= pageType === 'daily_rate' ? 'active' : '' %>"><i class="fa-solid fa-tags"></i>Rate Requests <% if (counts && counts.pendingRate > 0) { %><span class="badge bg-info ms-auto"><%= counts.pendingRate %></span><% } %></a>
                            <a href="/views/admin/requests_cost.php" class="luxury-nav-link <%= pageType === 'cost_price' ? 'active' : '' %>"><i class="fa-solid fa-key"></i>Cost Requests <% if (counts && counts.pendingCost > 0) { %><span class="badge bg-secondary ms-auto"><%= counts.pendingCost %></span><% } %></a>
                            <a href="/views/admin/inventory_stats.php" class="luxury-nav-link"><i class="fa-solid fa-chart-pie"></i>Inventory Stats</a>
                            <a href="/views/admin/sessions_report.php" class="luxury-nav-link"><i class="fa-solid fa-calendar-day"></i>Day Sessions</a>
                            <a href="/views/admin/reports.php" class="luxury-nav-link"><i class="fa-solid fa-file-invoice-dollar"></i>Reports</a>
                        <% } else { %>
                            <a href="/views/admin/home.php" class="luxury-nav-link"><i class="fa-solid fa-gauge"></i>Dashboard</a>
                            <a href="/views/pos/sell.php" class="luxury-nav-link"><i class="fa-solid fa-cart-shopping"></i>Selling</a>
                            <a href="/views/pos/rent.php" class="luxury-nav-link"><i class="fa-solid fa-clock-rotate-left"></i>POS</a>
                            <a href="/views/admin/inventory.php" class="luxury-nav-link"><i class="fa-solid fa-box"></i>Inventory</a>
                            <a href="/views/admin/requests_qty.php" class="luxury-nav-link <%= pageType === 'quantity' ? 'active' : '' %>"><i class="fa-solid fa-cubes-stacked"></i>Qty Requests <% if (counts && counts.pendingQty > 0) { %><span class="badge bg-warning text-dark ms-auto"><%= counts.pendingQty %></span><% } %></a>
                            <a href="/views/admin/requests_rate.php" class="luxury-nav-link <%= pageType === 'daily_rate' ? 'active' : '' %>"><i class="fa-solid fa-tags"></i>Rate Requests <% if (counts && counts.pendingRate > 0) { %><span class="badge bg-info ms-auto"><%= counts.pendingRate %></span><% } %></a>
                            <a href="/views/admin/requests_cost.php" class="luxury-nav-link <%= pageType === 'cost_price' ? 'active' : '' %>"><i class="fa-solid fa-key"></i>Cost Requests <% if (counts && counts.pendingCost > 0) { %><span class="badge bg-secondary ms-auto"><%= counts.pendingCost %></span><% } %></a>
                        <% } %>
                        <a href="/logout.php" class="luxury-nav-link logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom position-relative" style="border-color: var(--border-subtle) !important;">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="luxury-badge luxury-badge-gold">
                                <i class="fa-solid fa-code-pull-request"></i> 
                                <%= pageType === 'quantity' ? 'Stock Quantity Controls' : (pageType === 'daily_rate' ? 'Daily Rate Controls' : (pageType === 'cost_price' ? 'Cost Price Cipher Controls' : 'All Change Requests')) %>
                            </span>
                            <span class="text-muted small">&bull; <%= user.role === 'super_admin' ? 'Executive Approval Portal' : 'Admin Request Center' %></span>
                        </div>
                        <h1 class="h2 mb-0">
                            <%= pageType === 'quantity' ? 'Item Quantity Edit Requests' : (pageType === 'daily_rate' ? 'Daily Rate Edit Requests' : (pageType === 'cost_price' ? 'Cost Price Edit Requests' : 'Inventory Change Requests Hub')) %>
                        </h1>
                        <div id="realtimeClock" class="text-muted small mt-1"></div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2 mt-3 mt-md-0 flex-wrap">
                        <!-- Dropdown Menu to switch categories -->
                        <div class="dropdown">
                            <button class="btn btn-luxury-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-list-ul text-warning"></i> Switch Category
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg" style="background: var(--bg-surface); border: 1px solid var(--border-subtle);">
                                <li><h6 class="dropdown-header text-uppercase" style="font-size: 0.68rem; color: var(--gold-primary); letter-spacing: 1px;">Request Types</h6></li>
                                <li><a class="dropdown-item py-2 d-flex justify-content-between <%= pageType === 'quantity' ? 'active fw-bold' : '' %>" href="/views/admin/requests_qty.php">
                                    <span><i class="fa-solid fa-cubes-stacked text-warning me-2"></i>Item Qty Edit Requests</span>
                                    <span class="badge bg-warning-subtle text-warning"><%= counts ? counts.pendingQty : 0 %></span>
                                </a></li>
                                <li><a class="dropdown-item py-2 d-flex justify-content-between <%= pageType === 'daily_rate' ? 'active fw-bold' : '' %>" href="/views/admin/requests_rate.php">
                                    <span><i class="fa-solid fa-tags text-info me-2"></i>Daily Rate Edit Requests</span>
                                    <span class="badge bg-info-subtle text-info"><%= counts ? counts.pendingRate : 0 %></span>
                                </a></li>
                                <li><a class="dropdown-item py-2 d-flex justify-content-between <%= pageType === 'cost_price' ? 'active fw-bold' : '' %>" href="/views/admin/requests_cost.php">
                                    <span><i class="fa-solid fa-key text-secondary me-2"></i>Cost Price Edit Requests</span>
                                    <span class="badge bg-secondary-subtle text-secondary"><%= counts ? counts.pendingCost : 0 %></span>
                                </a></li>
                                <li><hr class="dropdown-divider" style="border-color: var(--border-subtle);"></li>
                                <li><a class="dropdown-item py-2 <%= pageType === 'all' ? 'active fw-bold' : '' %>" href="/views/admin/requests.php">
                                    <i class="fa-solid fa-table-list me-2"></i>All Requests (Summary)
                                </a></li>
                            </ul>
                        </div>

                        <!-- New Request Modal trigger button -->
                        <button type="button" class="btn btn-luxury-gold" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                            <i class="fa-solid fa-plus me-1"></i> Submit New Request
                        </button>

                        <a href="/views/admin/inventory.php" class="btn btn-luxury-outline">
                            <i class="fa-solid fa-boxes-stacked me-1"></i> Inventory
                        </a>

                        <button id="themeToggle" class="theme-toggle-btn">🌙 Dark Mode</button>
                    </div>
                </div>

                <% if (msg) { %>
                    <%- msg %>
                <% } %>

                <!-- Navigation Tabs between request pages -->
                <ul class="nav nav-pills mb-4 p-2 rounded-3" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle);">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 <%= pageType === 'quantity' ? 'active' : 'text-muted' %>" href="/views/admin/requests_qty.php">
                            <i class="fa-solid fa-cubes-stacked"></i> Quantity Edit Requests
                            <span class="badge <%= pageType === 'quantity' ? 'bg-dark text-warning' : 'bg-warning-subtle text-warning' %>"><%= counts ? counts.pendingQty : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 <%= pageType === 'daily_rate' ? 'active' : 'text-muted' %>" href="/views/admin/requests_rate.php">
                            <i class="fa-solid fa-tags"></i> Daily Rate Edit Requests
                            <span class="badge <%= pageType === 'daily_rate' ? 'bg-dark text-info' : 'bg-info-subtle text-info' %>"><%= counts ? counts.pendingRate : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 <%= pageType === 'cost_price' ? 'active' : 'text-muted' %>" href="/views/admin/requests_cost.php">
                            <i class="fa-solid fa-key"></i> Cost Price Edit Requests
                            <span class="badge <%= pageType === 'cost_price' ? 'bg-dark text-secondary' : 'bg-secondary-subtle text-secondary' %>"><%= counts ? counts.pendingCost : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item ms-auto">
                        <a class="nav-link d-flex align-items-center gap-2 <%= pageType === 'all' ? 'active' : 'text-muted' %>" href="/views/admin/requests.php">
                            <i class="fa-solid fa-bars-staggered"></i> View All
                        </a>
                    </li>
                </ul>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-lg-3">
                        <div class="luxury-stat-card p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Awaiting SA Approval</span>
                                <div class="rounded-3 p-2" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                                    <i class="fa-solid fa-hourglass-half fs-5"></i>
                                </div>
                            </div>
                            <div class="luxury-stat-value my-1" style="font-size: 1.75rem; color: #f59e0b;">
                                <%= requests.filter(r => r.status === 'pending').length %>
                            </div>
                            <small class="text-muted">Pending executive review</small>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="luxury-stat-card p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Accepted & Unlocked</span>
                                <div class="rounded-3 p-2" style="background: rgba(16, 185, 129, 0.12); color: var(--success-emerald);">
                                    <i class="fa-solid fa-unlock-keyhole fs-5"></i>
                                </div>
                            </div>
                            <div class="luxury-stat-value my-1" style="font-size: 1.75rem; color: var(--success-emerald);">
                                <%= requests.filter(r => r.status === 'approved').length %>
                            </div>
                            <small class="text-muted">Linked edit buttons ready</small>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="luxury-stat-card p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Completed / Applied</span>
                                <div class="rounded-3 p-2" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa;">
                                    <i class="fa-solid fa-circle-check fs-5"></i>
                                </div>
                            </div>
                            <div class="luxury-stat-value my-1" style="font-size: 1.75rem; color: #60a5fa;">
                                <%= requests.filter(r => r.status === 'completed').length %>
                            </div>
                            <small class="text-muted">Item values updated in catalog</small>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="luxury-stat-card p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Total In Scope</span>
                                <div class="rounded-3 p-2" style="background: var(--gold-subtle-bg); color: var(--gold-primary);">
                                    <i class="fa-solid fa-clipboard-list fs-5"></i>
                                </div>
                            </div>
                            <div class="luxury-stat-value my-1" style="font-size: 1.75rem; color: var(--gold-primary);">
                                <%= requests.length %>
                            </div>
                            <small class="text-muted">Total requests recorded</small>
                        </div>
                    </div>
                </div>

                <!-- Requests List Table -->
                <div class="luxury-card overflow-hidden mb-5">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: var(--border-subtle) !important;">
                        <div>
                            <h5 class="fw-bold mb-0">Change Request Registry</h5>
                            <small class="text-muted">Audit trail of permission requests, SA approvals, and cashier edit actions</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" id="tableFilterInput" class="form-control form-control-sm luxury-input" placeholder="Search item or cashier..." oninput="filterTable()" style="width: 220px;">
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="luxury-table align-middle" id="requestsTable">
                            <thead>
                                <tr>
                                    <th>Req ID</th>
                                    <th>Target Item</th>
                                    <th>Category Type</th>
                                    <th>Current &rarr; Requested</th>
                                    <th>Reason / Note</th>
                                    <th>Requested By</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions / Authorization</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (requests && requests.length > 0) { %>
                                    <% requests.forEach(function(req) { %>
                                    <tr>
                                        <!-- Req ID -->
                                        <td class="text-muted fw-bold" style="font-family: var(--font-heading);">
                                            #REQ-<%= String(req.id).padStart(3, '0') %>
                                        </td>

                                        <!-- Target Item -->
                                        <td>
                                            <div class="fw-bold text-main"><%= req.item_name %></div>
                                            <small class="text-muted">Item ID #<%= req.item_id %></small>
                                        </td>

                                        <!-- Request Type -->
                                        <td>
                                            <% if (req.type === 'quantity') { %>
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                    <i class="fa-solid fa-cubes-stacked me-1"></i> Quantity
                                                </span>
                                            <% } else if (req.type === 'daily_rate') { %>
                                                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                    <i class="fa-solid fa-tags me-1"></i> Daily Rate
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                    <i class="fa-solid fa-key me-1"></i> Cost Price
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Current -> Requested -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-muted small text-decoration-line-through">
                                                    <%= req.type === 'daily_rate' ? 'Rs. ' : '' %><%= req.current_value %><%= req.type === 'quantity' ? ' units' : '' %>
                                                </span>
                                                <i class="fa-solid fa-arrow-right small text-warning"></i>
                                                <span class="fw-bold" style="color: var(--gold-primary);">
                                                    <%= req.type === 'daily_rate' ? 'Rs. ' : '' %><%= req.requested_value %><%= req.type === 'quantity' ? ' units' : '' %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Reason / Note -->
                                        <td>
                                            <div class="small" style="max-width: 240px; line-height: 1.4;">
                                                <%= req.reason || 'No details provided' %>
                                            </div>
                                            <% if (req.sa_notes) { %>
                                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                                    <strong>SA Note:</strong> <%= req.sa_notes %>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Requested By & Date -->
                                        <td>
                                            <div class="small fw-semibold"><i class="fa-solid fa-user me-1 text-muted"></i><%= req.requested_by %></div>
                                            <div class="text-muted" style="font-size: 0.7rem;">
                                                <%= new Date(req.requested_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> &bull; 
                                                <%= new Date(req.requested_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                            </div>
                                        </td>

                                        <!-- Status Badge -->
                                        <td>
                                            <% if (req.status === 'pending') { %>
                                                <span class="badge bg-warning text-dark px-2 py-1">
                                                    <i class="fa-solid fa-hourglass-half me-1"></i> Pending SA
                                                </span>
                                            <% } else if (req.status === 'approved') { %>
                                                <span class="badge bg-success px-2 py-1">
                                                    <i class="fa-solid fa-check me-1"></i> Approved (Unlocked)
                                                </span>
                                            <% } else if (req.status === 'rejected') { %>
                                                <span class="badge bg-danger px-2 py-1">
                                                    <i class="fa-solid fa-ban me-1"></i> Rejected
                                                </span>
                                            <% } else if (req.status === 'completed') { %>
                                                <span class="badge bg-secondary px-2 py-1">
                                                    <i class="fa-solid fa-check-double me-1"></i> Completed
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Action Controls -->
                                        <td class="text-end text-nowrap">
                                            <% if (user.role === 'super_admin') { %>
                                                <% if (req.status === 'pending') { %>
                                                    <div class="d-inline-flex gap-1">
                                                        <form method="POST" action="/api/requests/approve" class="d-inline m-0">
                                                            <input type="hidden" name="request_id" value="<%= req.id %>">
                                                            <input type="hidden" name="redirect_to" value="/views/admin/requests_<%= pageType === 'daily_rate' ? 'rate' : (pageType === 'cost_price' ? 'cost' : 'qty') %>.php">
                                                            <button type="submit" class="btn btn-sm btn-success px-2 py-1" title="Accept & Authorize Admin">
                                                                <i class="fa-solid fa-check me-1"></i> Accept
                                                            </button>
                                                        </form>
                                                        <form method="POST" action="/api/requests/reject" class="d-inline m-0">
                                                            <input type="hidden" name="request_id" value="<%= req.id %>">
                                                            <input type="hidden" name="redirect_to" value="/views/admin/requests_<%= pageType === 'daily_rate' ? 'rate' : (pageType === 'cost_price' ? 'cost' : 'qty') %>.php">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" title="Reject Request" onclick="return confirm('Reject this edit request?');">
                                                                <i class="fa-solid fa-xmark"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                <% } else if (req.status === 'approved') { %>
                                                    <a href="/views/admin/inventory.php?edit=<%= req.item_id %>&grant_id=<%= req.id %>#itemForm" class="btn btn-sm btn-luxury-outline py-1 px-2 text-warning">
                                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Item
                                                    </a>
                                                <% } else { %>
                                                    <span class="text-muted small">—</span>
                                                <% } %>
                                            <% } else { %>
                                                <!-- Admin (Cashier) Controls -->
                                                <% if (req.status === 'approved') { %>
                                                    <!-- LINKED BUTTON TO EDIT THAT ASKED ITEM DETAIL -->
                                                    <a href="/views/admin/inventory.php?edit=<%= req.item_id %>&grant_id=<%= req.id %>#itemForm" 
                                                       class="btn btn-sm btn-luxury-gold fw-bold text-nowrap py-1 px-3 shadow-sm"
                                                       title="Super Admin accepted! Click to edit this item">
                                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Item <%= req.type === 'quantity' ? 'Qty' : (req.type === 'daily_rate' ? 'Rate' : 'Cost') %>
                                                    </a>
                                                <% } else if (req.status === 'pending') { %>
                                                    <span class="text-muted small"><i class="fa-solid fa-clock me-1 text-warning"></i>Awaiting SA</span>
                                                <% } else if (req.status === 'completed') { %>
                                                    <span class="badge bg-secondary-subtle text-secondary small"><i class="fa-solid fa-circle-check text-success me-1"></i>Updated</span>
                                                <% } else { %>
                                                    <span class="text-danger small"><i class="fa-solid fa-circle-xmark me-1"></i>Declined</span>
                                                <% } %>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="fa-solid fa-clipboard-check d-block fs-1 mb-2 opacity-50"></i>
                                            No <%= pageType !== 'all' ? pageType.replace('_', ' ') : '' %> change requests recorded yet.
                                            <% if (user.role !== 'super_admin') { %>
                                                <div class="mt-2">
                                                    <button type="button" class="btn btn-sm btn-luxury-gold" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                                                        <i class="fa-solid fa-plus me-1"></i> Create First Request
                                                    </button>
                                                </div>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- NEW CHANGE REQUEST MODAL -->
    <div class="modal fade" id="newRequestModal" tabindex="-1" aria-labelledby="newRequestModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); color: var(--text-main);">
                <div class="modal-header border-bottom" style="border-color: var(--border-subtle) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: var(--gold-subtle-bg); color: var(--gold-primary);">
                            <i class="fa-solid fa-paper-plane"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0" id="newRequestModalLabel">Submit Item Change Request</h5>
                            <small class="text-muted">Sends an authorization request to Super Admin</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <form method="POST" action="/api/requests/create">
                    <input type="hidden" name="redirect_to" value="/views/admin/requests_<%= pageType === 'daily_rate' ? 'rate' : (pageType === 'cost_price' ? 'cost' : 'qty') %>.php">
                    <div class="modal-body p-4">
                        <!-- Target Item Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Select Item</label>
                            <select class="form-select luxury-input" name="item_id" id="modalItemSelect" required onchange="updateCurrentValuePreview()">
                                <option value="" disabled selected>-- Choose Product from Catalog --</option>
                                <% if (items && items.length > 0) { %>
                                    <% items.forEach(function(it) { %>
                                        <option value="<%= it.item_id %>" 
                                                data-qty="<%= it.stock_quantity %>" 
                                                data-rate="<%= it.price_per_unit %>" 
                                                data-cost="<%= it.bought_price || '' %>">
                                            #<%= String(it.item_id).padStart(4, '0') %> - <%= it.item_name %> (<%= it.category %>)
                                        </option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <!-- Request Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Change Category</label>
                            <select class="form-select luxury-input" name="type" id="modalTypeSelect" required onchange="updateCurrentValuePreview()">
                                <option value="quantity" <%= pageType === 'quantity' ? 'selected' : '' %>>Item Quantity Control (Stock Count)</option>
                                <option value="daily_rate" <%= pageType === 'daily_rate' ? 'selected' : '' %>>Daily Rate / Unit Price (LKR)</option>
                                <option value="cost_price" <%= pageType === 'cost_price' ? 'selected' : '' %>>Cost Price / BLACKHORSE Cipher</option>
                            </select>
                        </div>

                        <!-- Current Value Display -->
                        <div class="mb-3 p-3 rounded-3" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle);">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Current Recorded Value:</span>
                                <span id="currentValDisplay" class="fw-bold" style="color: var(--gold-primary);">Select an item</span>
                            </div>
                        </div>

                        <!-- Requested Value Input -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted" id="requestedValueLabel">Requested New Value</label>
                            <input type="text" class="form-control luxury-input" name="requested_value" id="requestedValueInput" required placeholder="Enter new quantity, rate, or cipher">
                        </div>

                        <!-- Business Reason -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold small text-muted">Reason for Request</label>
                            <textarea class="form-control luxury-input" name="reason" rows="3" required placeholder="Explain why this change is needed (e.g. supplier delivery, market price adjustment, purchase receipt note)..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top" style="border-color: var(--border-subtle) !important;">
                        <button type="button" class="btn btn-luxury-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="fa-solid fa-paper-plane me-1"></i> Send to Super Admin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Realtime Clock Function
        function updateClock() {
            const now = new Date();
            const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
            const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
            const el = document.getElementById('realtimeClock');
            if (el) el.innerHTML = '<i class="fa-regular fa-clock me-1"></i> ' + dateStr + ' &bull; ' + timeStr;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Dark Mode Logic
        const toggleBtn = document.getElementById('themeToggle');
        const html = document.documentElement;

        function updateToggleText() {
            if (html.getAttribute('data-bs-theme') === 'dark') {
                toggleBtn.innerHTML = '☀️ Light Mode';
            } else {
                toggleBtn.innerHTML = '🌙 Dark Mode';
            }
        }

        if (localStorage.getItem('theme') === 'dark') {
            html.setAttribute('data-bs-theme', 'dark');
            updateToggleText();
        }

        toggleBtn.addEventListener('click', () => {
            if (html.getAttribute('data-bs-theme') === 'dark') {
                html.setAttribute('data-bs-theme', 'light');
                localStorage.setItem('theme', 'light');
            } else {
                html.setAttribute('data-bs-theme', 'dark');
                localStorage.setItem('theme', 'dark');
            }
            updateToggleText();
        });

        // Current Value Preview in Modal
        function updateCurrentValuePreview() {
            const itemSelect = document.getElementById('modalItemSelect');
            const typeSelect = document.getElementById('modalTypeSelect');
            const display = document.getElementById('currentValDisplay');
            const inputLabel = document.getElementById('requestedValueLabel');
            const inputField = document.getElementById('requestedValueInput');

            if (!itemSelect || !typeSelect || !display) return;
            const opt = itemSelect.options[itemSelect.selectedIndex];
            if (!opt || !opt.dataset) {
                display.innerText = 'Select an item';
                return;
            }

            const type = typeSelect.value;
            if (type === 'quantity') {
                display.innerText = (opt.dataset.qty || '0') + ' units in stock';
                inputLabel.innerText = 'Requested New Stock Quantity';
                inputField.type = 'number';
                inputField.placeholder = 'e.g. 15';
            } else if (type === 'daily_rate') {
                display.innerText = 'Rs. ' + Number(opt.dataset.rate || 0).toFixed(2);
                inputLabel.innerText = 'Requested New Selling / Daily Rate (LKR)';
                inputField.type = 'number';
                inputField.step = '0.01';
                inputField.placeholder = 'e.g. 2500.00';
            } else if (type === 'cost_price') {
                display.innerText = opt.dataset.cost ? opt.dataset.cost : 'No cost cipher set';
                inputLabel.innerText = 'Requested Cost Price or BLACKHORSE Cipher';
                inputField.type = 'text';
                inputField.placeholder = 'e.g. 12000 or BLACKHORSE code';
            }
        }

        // Table search filter
        function filterTable() {
            const val = document.getElementById('tableFilterInput').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#requestsTable tbody tr');
            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                r.style.display = text.includes(val) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
